{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mailpulse;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_SECURE_KEY_AT_LEAST_32_CHARS_LONG_!!!",
    "Issuer": "MailPulse",
    "Audience": "MailPulseClient"
  },
  "Encryption": {
    "Key": "CHANGE_THIS_TO_A_SECURE_ENCRYPTION_KEY_!!!"
  },
  "ClientApp": {
    "ResetPasswordUrl": "http://localhost:5173/reset-password"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/log-.txt", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  },
  "AllowedHosts": "*"
}
